{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vianova-ds-docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "vianova-ds-export",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/www/scripts/serve-static.mjs",
        "--dir",
        "apps/www/out",
        "--port",
        "3400"
      ],
      "port": 3400
    },
    {
      "name": "vianova-ds-docs-isolated",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "NEXT_DIST_DIR=node_modules/.next-claude",
        "pnpm",
        "--filter",
        "@vianova/www",
        "exec",
        "next",
        "dev",
        "-p",
        "3005"
      ],
      "port": 3005
    },
    {
      "name": "vianova-ds-export-pages",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/www/scripts/serve-static.mjs",
        "--dir",
        "apps/www/out",
        "--port",
        "3401",
        "--prefix",
        "/vianova-ds"
      ],
      "port": 3401
    }
  ]
}

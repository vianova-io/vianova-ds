{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vianova-ds-docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "vianova-ds-export",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/www/scripts/serve-static.mjs",
        "--dir",
        "apps/www/out",
        "--port",
        "3400"
      ],
      "port": 3400
    }
  ]
}
